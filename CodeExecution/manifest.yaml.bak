apiVersion: apps/v1
kind: Deployment
metadata:
  name: findtherebels
  namespace: rootthebox
spec: 
  replicas: 1
  selector:
      matchLabels:
        app: findtherebels
  template:
    metadata:
      labels:
        app: findtherebels
    spec:
      containers:
      - name: findtherebels
        image: empathctf.azurecr.io/event2-findtherebels:latest
        ports:
        - containerPort: 8080
---
apiVersion: v1
kind: Service
metadata:
  name: findtherebels
  namespace: rootthebox
spec:
  ports:
  - port: 80
    targetPort: 8080
  selector:
    app: findtherebels
  # type: ClusterIP
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: findtherebels-ingress
  namespace: rootthebox
spec:
  ingressClassName: nginx
  tls:
  - hosts:
    - findtherebels.tamagodzilla.lol
    secretName: tamazilla
  rules:
  - host: findtherebels.tamagodzilla.lol
    http:
      paths:
        - pathType: Prefix
          path: "/"
          backend:
            service:
              name: findtherebels
              port:
                number: 80
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: ingress-nginx-controller
  namespace: ingress-nginx
  labels:
    app.kubernetes.io/name: findtherebels-ingress
    app.kubernetes.io/part-of: ingress-nginx
data: 
  use-forwarded-headers: "true"


